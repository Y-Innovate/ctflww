#* Deploy ctf repository

#* Source and target libs
srcdbrmlib    := $(srchlq).DBRM
tgtdbrmlib    := $(tgthlq).DBRM

srcloadlib    := $(srchlq).LOAD
tgtloadlib    := $(tgthlq).LOAD

srczmakelib   := $(srchlq).ZMAKE
tgtzmakelib   := $(tgthlq).ZMAKE

tgtddllib     := $(tgthlq).DDL
tgtjcllib     := $(tgthlq).JCL

ddldir        := $(gitdir)/DDL
ddlfiles      := ${sh cd $(gitdir)/DDL; +
                      find * -prune -type f -name "*.sql" 2>&1 | +
                      grep -v EDC5129I}
ddlmems       := ${stripext $(ddlfiles)}
ddltgts       := ${addpdsname $(tgtddllib),$(ddlmems)}

jcldir        := $(gitdir)/JCL
jclfiles      := ${sh cd $(gitdir)/JCL; +
                      find * -prune -type f -name "*.jcl" 2>&1 | +
                      grep -v EDC5129I}
jclmems       := ${stripext $(jclfiles)}
jcltgts       := ${addpdsname $(tgtjcllib),$(jclmems)}

dbrmmems      := ${memberlist $(srcdbrmlib)}
dbrmtgts      := ${addpdsname $(tgtdbrmlib),$(dbrmmems)}

loadmems      := ${memberlist $(srcloadlib)}
loaddb2mems   := ${memberlist $(srcloadlib),CTFM}
loadothmems   := ${function NOTIN SET1($(loadmems))+
                                  SET2($(loaddb2mems))}
loadothtgts   := ${addpdsname $(tgtloadlib),$(loadothmems)}

#* The public transaction has its own plan and collection. Add a module
#* here if a public path calls it. CTFM910 (submit transaction) and
#* CTFM314 (leaderboard) are also used by private transactions, so they
#* are in both collections. All others are private.
loadpubmems   := CTFM202 CTFM302 CTFM303 CTFM304 CTFM305
loadbothmems  := CTFM910 CTFM314
loadnotprv    := $(loadpubmems) $(loadbothmems)
loadprvmems   := ${function NOTIN SET1($(loaddb2mems))+
                                  SET2($(loadnotprv))}
loadpubtgts   := ${addpdsname $(tgtloadlib),$(loadpubmems)}
loadbothtgts  := ${addpdsname $(tgtloadlib),$(loadbothmems)}
loadprvtgts   := ${addpdsname $(tgtloadlib),$(loadprvmems)}

zmakemems     := ${memberlist $(srczmakelib)}
zmaketgts     := ${addpdsname $(tgtzmakelib),$(zmakemems)}

#* Data sets grouped by characteristics
recfmFB80     := $(tgtddllib) $(tgtjcllib) $(tgtdbrmlib) $(tgtzmakelib)
recfmU        := $(tgtloadlib)

datasets      := $(recfmFB80) $(recfmU)

#* Combine targets
#* Only DDL and JCL, for when the tables must change before a BIND
.PHONY DEPLOY_DDL
DEPLOY_DDL : $(recfmFB80) $(ddltgts) $(jcltgts)

.PHONY DEPLOY_ALL
DEPLOY_ALL : $(datasets) $(ddltgts) $(jcltgts) $(dbrmtgts)+
             $(loadprvtgts) $(loadpubtgts) $(loadbothtgts)+
             $(loadothtgts) $(zmaketgts)

#* Build targets
$(ddltgts) : $(gitdir)/DDL/$%.sql
- CALL UNIXCMD0 $(gitdir)/python/profileUSS.sh $(gitdir)/DDL $%.sql+
-               $(gitdir)/envs/$(envl).yaml | +
-               iconv -f 1047 -t 037 -T > /tmp/$%.sql
- CALL OGETU '/tmp/$%.sql' '$@'
- CALL UNIXCMD0 rm /tmp/$%.sql

$(jcltgts) : $(gitdir)/JCL/$%.jcl
- CALL UNIXCMD0 $(gitdir)/python/profileUSS.sh $(gitdir)/JCL $%.jcl+
-               $(gitdir)/envs/$(envl).yaml | +
-               iconv -f 1047 -t 037 -T > /tmp/$%.jcl
- CALL OGETU '/tmp/$%.jcl' '$@'
- CALL UNIXCMD0 rm /tmp/$%.jcl

$(dbrmtgts) : $(srcdbrmlib)($%)
- CALL IEBCOPY PDSIN($(srcdbrmlib)) PDSOUT($(tgtdbrmlib))+
-              MEMBER($%) PRINTSUCCESS(NO)

$(loadothtgts) : $(srcloadlib)($%)
- CALL IEBCOPY PDSIN($(srcloadlib)) PDSOUT($(tgtloadlib))+
-              MEMBER($%) PRINTSUCCESS(NO)

$(loadprvtgts) : $(srcloadlib)($%)
- CALL IEBCOPY PDSIN($(srcloadlib)) PDSOUT($(tgtloadlib))+
-              MEMBER($%) PRINTSUCCESS(NO)
- CALL BIND SYSTEM(DBY1) PACKAGE(CTF$(ctfdb)) MEMBER($%)+
-           OWNER(CTF$(ctfdb)) QUALIFIER(CTF$(ctfdb))+
-           LIBRARY('$(tgtdbrmlib)')+
-           VALIDATE(BIND)

$(loadpubtgts) : $(srcloadlib)($%)
- CALL IEBCOPY PDSIN($(srcloadlib)) PDSOUT($(tgtloadlib))+
-              MEMBER($%) PRINTSUCCESS(NO)
- CALL BIND SYSTEM(DBY1) PACKAGE(CTF$(ctfdb)P) MEMBER($%)+
-           OWNER(CTF$(ctfdb)) QUALIFIER(CTF$(ctfdb))+
-           LIBRARY('$(tgtdbrmlib)')+
-           VALIDATE(BIND)

$(loadbothtgts) : $(srcloadlib)($%)
- CALL IEBCOPY PDSIN($(srcloadlib)) PDSOUT($(tgtloadlib))+
-              MEMBER($%) PRINTSUCCESS(NO)
- CALL BIND SYSTEM(DBY1) PACKAGE(CTF$(ctfdb)) MEMBER($%)+
-           OWNER(CTF$(ctfdb)) QUALIFIER(CTF$(ctfdb))+
-           LIBRARY('$(tgtdbrmlib)')+
-           VALIDATE(BIND)
- CALL BIND SYSTEM(DBY1) PACKAGE(CTF$(ctfdb)P) MEMBER($%)+
-           OWNER(CTF$(ctfdb)) QUALIFIER(CTF$(ctfdb))+
-           LIBRARY('$(tgtdbrmlib)')+
-           VALIDATE(BIND)

$(zmaketgts) : $(srczmakelib)($%)
- CALL IEBCOPY PDSIN($(srczmakelib)) PDSOUT($(tgtzmakelib))+
-              MEMBER($%) PRINTSUCCESS(NO)

#* Allocate LRECL=80 RECFM=FB data sets
$(recfmFB80) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(F,B) LRECL(80)+
-             CYLINDERS SPACE(1,1) DSORG(PO) DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')

#* Allocate LRECL=0 RECFM=U data sets
$(recfmU) :
- CALL TSOCMD ALLOC DATASET('$@') NEW RECFM(U) LRECL(0)+
-             BLKSIZE(32760) CYLINDERS SPACE(1,1) DSORG(PO)+
-             DSNTYPE(LIBRARY)
- CALL TSOCMD FREE DATASET('$@')
