//CTFCSD   JOB 'CTF CSD DEFS',CLASS=A,MSGCLASS=A,NOTIFY=&SYSUID
//*
//UPDCSD  EXEC PGM=DFHCSDUP,REGION=1M
//STEPLIB   DD DISP=SHR,DSN={{CICSHLQ}}.CICS.SDFHLOAD
//DFHCSD    DD DISP=SHR,DSN={{CICSCSD}}
//SYSIN     DD *
DEFINE TRANSACTION({{CICSTXN_PUBLIC}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF PUBLIC TRANSACTION')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_PUBLIC}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF PUBLIC DB2ENTRY')
       TRANSID({{CICSTXN_PUBLIC}}) PLAN({{DB2PLAN_PUBLIC}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_PLAYER}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF PLAYER TRANSACTION')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_PLAYER}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF PLAYER DB2ENTRY')
       TRANSID({{CICSTXN_PLAYER}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_ADMIN}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF ADMIN TRANSACTION')
       PROGRAM(DFHWBA)
DEFINE DB2ENTRY({{CICSTXN_ADMIN}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF ADMIN DB2ENTRY')
       TRANSID({{CICSTXN_ADMIN}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_SUBMIT}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF JOB SUBMISSION')
       PROGRAM(CTFC910)
DEFINE DB2ENTRY({{CICSTXN_SUBMIT}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF JOB SUBMISSION DB2ENTRY')
       TRANSID({{CICSTXN_SUBMIT}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE LIBRARY({{CICSLIB}}) GROUP({{CICSGRP}})
       DESCRIPTION('CTF LOAD LIBRARY')
       DSNAME01({{LOADLIB}})
ADD G({{CICSGRP}}) LI({{CICSLST}})
//CBDOUT    DD SYSOUT=*
//SYSUT1    DD UNIT=SYSDA,SPACE=(1024,(100,100))
//SYSPRINT  DD SYSOUT=*
