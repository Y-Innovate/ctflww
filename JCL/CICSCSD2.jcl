//CBDOUT    DD SYSOUT=*
//SYSUT1    DD UNIT=SYSDA,SPACE=(1024,(100,100))
//SYSPRINT  DD SYSOUT=*
//*
//UPDCSDA EXEC PGM=DFHCSDUP,REGION=1M
//STEPLIB   DD DISP=SHR,DSN={{CICSHLQ}}.CICS.SDFHLOAD
//DFHCSD    DD DISP=SHR,DSN={{CICSCSD}}
//SYSIN     DD *
DEFINE TRANSACTION({{CICSTXN_PUBLIC}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF PUBLIC TRANSACTION')
       PROGRAM(DFHMIRS) PROFILE(DFHCICSA)
DEFINE DB2ENTRY({{CICSTXN_PUBLIC}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF PUBLIC DB2ENTRY')
       TRANSID({{CICSTXN_PUBLIC}}) PLAN({{DB2PLAN_PUBLIC}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_PLAYER}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF PLAYER TRANSACTION')
       PROGRAM(DFHMIRS) PROFILE(DFHCICSA)
DEFINE DB2ENTRY({{CICSTXN_PLAYER}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF PLAYER DB2ENTRY')
       TRANSID({{CICSTXN_PLAYER}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_ADMIN}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF ADMIN TRANSACTION')
       PROGRAM(DFHMIRS) PROFILE(DFHCICSA)
DEFINE DB2ENTRY({{CICSTXN_ADMIN}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF ADMIN DB2ENTRY')
       TRANSID({{CICSTXN_ADMIN}}) PLAN({{DB2PLAN}})
       AUTHTYPE(USERID)
DEFINE TRANSACTION({{CICSTXN_SUBMIT}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF JOB SUBMISSION')
