       AUTHTYPE(USERID)
DEFINE LIBRARY({{CICSLIB}}) GROUP({{CICSGRPA}})
       DESCRIPTION('CTF LOAD LIBRARY')
       DSNAME01({{LOADLIB}})
ADD G({{CICSGRPA}}) LI({{CICSLSTA}})
